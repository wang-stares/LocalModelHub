<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LocalModelHub.App.ViewModels"
             x:Class="LocalModelHub.App.Views.LibraryView"
             x:DataType="vm:LibraryViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="30,0,30,30" Spacing="16">

      <Border Classes="card" CornerRadius="20" Padding="20">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="7">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <TextBlock Text="推理运行时 · llama.cpp" Classes="h3"/>
              <Border Classes="badge" Classes.accent="{Binding RuntimeInstalled}">
                <TextBlock Text="{Binding RuntimeStateText}"/>
              </Border>
            </StackPanel>
            <TextBlock Text="{Binding RuntimePath}" Classes="caption" TextTrimming="CharacterEllipsis" MaxWidth="620"/>
            <TextBlock Text="{Binding RuntimeStatus}" Classes="caption" TextWrapping="Wrap" MaxWidth="620"/>
            <ProgressBar Value="{Binding RuntimeProgress}" Maximum="100" Height="5" IsVisible="{Binding IsInstallingRuntime}" MaxWidth="420" HorizontalAlignment="Left"/>
          </StackPanel>
          <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto">
            <Button Classes="ghost"
                    Content="查看日志"
                    Command="{Binding ViewLogsCommand}"
                    Margin="0,0,8,0"/>
            <Button Grid.Column="1"
                    Classes="ghost"
                    Content="安装 / 修复运行时"
                    Command="{Binding InstallRuntimeCommand}"
                    IsEnabled="{Binding !IsInstallingRuntime}"
                    VerticalAlignment="Center"/>
          </Grid>
        </Grid>
      </Border>

      <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4,0,0">
        <StackPanel Spacing="3">
          <TextBlock Text="本机模型" Classes="h2"/>
          <TextBlock Text="{Binding CountText}" Classes="caption"/>
        </StackPanel>
        <Button Grid.Column="1" Classes="ghost" Content="刷新" Command="{Binding RefreshModelsCommand}" Margin="0,0,8,0" VerticalAlignment="Center"/>
        <Button Grid.Column="2" Classes="ghost" Content="打开模型目录" Command="{Binding OpenModelsFolderCommand}" VerticalAlignment="Center"/>
      </Grid>

      <Border Classes="card" Padding="16" CornerRadius="16" IsVisible="{Binding IsServerRunning}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Ellipse Width="8" Height="8" Fill="{DynamicResource Success}" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Margin="10,0,10,0" Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="当前推理服务运行中" Classes="h3" FontSize="12.5"/>
            <TextBlock Text="{Binding ServerText}" Classes="caption"/>
          </StackPanel>
          <Button Grid.Column="2" Classes="danger" Content="停止服务" Command="{Binding StopServerCommand}"/>
        </Grid>
      </Border>

      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:LibraryItemViewModel">
            <Border Classes="card cardHover" Padding="16" Margin="0,0,0,10" CornerRadius="16">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Width="42" Height="42" CornerRadius="13" Background="{DynamicResource AvatarBg}">
                  <TextBlock Text="{Binding Initial}"
                             FontSize="13"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource Accent}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="13,0,13,0" Spacing="4" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Title}" Classes="h3" VerticalAlignment="Center"/>
                    <Border Classes="badge"
                            Classes.cn="{Binding IsChinese}"
                            Classes.intl="{Binding !IsChinese}"
                            Classes.local="{Binding IsLocal}">
                      <TextBlock Text="{Binding OriginText}"/>
                    </Border>
                    <Border Classes="badge fitPerfect" IsVisible="{Binding IsRunning}">
                      <TextBlock Text="运行中"/>
                    </Border>
                  </StackPanel>
                  <TextBlock Text="{Binding StatusText}" Classes="muted" FontSize="11.5"/>
                  <TextBlock Text="{Binding PathText}" Classes="caption" TextTrimming="CharacterEllipsis" MaxWidth="520"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Button Classes="primary"
                          Content="启动模型"
                          Command="{Binding LaunchCommand}"
                          IsVisible="{Binding !IsRunning}"
                          MinWidth="96"
                          HorizontalContentAlignment="Center"
                          ToolTip.Tip="加载到 llama.cpp 推理服务并跳转到对话页"/>
                  <Button Classes="danger"
                          Content="停止服务"
                          Command="{Binding StopCommand}"
                          IsVisible="{Binding IsRunning}"
                          MinWidth="96"
                          HorizontalContentAlignment="Center"
                          ToolTip.Tip="停止推理服务，释放显存与内存"/>
                  <Button Classes="ghost" Content="目录" Command="{Binding RevealCommand}" ToolTip.Tip="在文件管理器中打开模型文件夹"/>
                  <Button Classes="danger" Content="删除" Command="{Binding DeleteCommand}" ToolTip.Tip="从磁盘删除模型文件"/>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Classes="card" Padding="36" CornerRadius="20" IsVisible="{Binding IsEmpty}">
        <StackPanel Spacing="10" HorizontalAlignment="Center">
          <TextBlock Text="还没有本地模型" Classes="h3" HorizontalAlignment="Center"/>
          <TextBlock Text="先去模型商店挑一个适合这台电脑的模型；已经下载好的 GGUF 也可以在商店页导入。"
                     Classes="muted"
                     HorizontalAlignment="Center"
                     TextWrapping="Wrap"
                     MaxWidth="480"/>
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,6,0,0">
            <Button Classes="primary" Content="去模型商店下载" Command="{Binding OpenStoreCommand}"/>
            <Button Classes="ghost" Content="打开模型目录" Command="{Binding OpenModelsFolderCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
