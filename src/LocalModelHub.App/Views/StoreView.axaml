<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LocalModelHub.App.ViewModels"
             xmlns:views="using:LocalModelHub.App.Views"
             x:Class="LocalModelHub.App.Views.StoreView"
             x:DataType="vm:StoreViewModel">
  <Grid RowDefinitions="Auto,*">
    <StackPanel Margin="32,14,32,10" Spacing="9">
      <Border Classes="card flat" Padding="15,12">
        <StackPanel Spacing="9">
          <Grid ColumnDefinitions="38,*">
            <TextBlock Text="来源" Classes="eyebrow" VerticalAlignment="Center"/>
            <Border Grid.Column="1" Classes="segmentHost" HorizontalAlignment="Left">
              <ListBox Classes="segments"
                       ItemsSource="{Binding SourceFilters}"
                       SelectedIndex="{Binding SourceIndex, Mode=TwoWay}">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
              </ListBox>
            </Border>
          </Grid>
          <Grid ColumnDefinitions="38,*">
            <TextBlock Text="地区" Classes="eyebrow" VerticalAlignment="Center"/>
            <Border Grid.Column="1" Classes="segmentHost" HorizontalAlignment="Left">
              <ListBox Classes="segments"
                       ItemsSource="{Binding OriginFilters}"
                       SelectedIndex="{Binding OriginIndex, Mode=TwoWay}">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
              </ListBox>
            </Border>
          </Grid>
          <Grid ColumnDefinitions="38,*">
            <TextBlock Text="能力" Classes="eyebrow" VerticalAlignment="Center"/>
            <Border Grid.Column="1" Classes="segmentHost" HorizontalAlignment="Left">
              <ListBox Classes="segments"
                       ItemsSource="{Binding CapabilityFilters}"
                       SelectedIndex="{Binding CapabilityIndex, Mode=TwoWay}">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
              </ListBox>
            </Border>
          </Grid>

          <Border Height="1" Background="{DynamicResource StrokeSubtle}" Margin="0,1"/>

          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBox Classes="search"
                     Width="280"
                     Watermark="搜索模型 / 厂商 / 标签"
                     Text="{Binding SearchText, Mode=TwoWay}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="12,0">
              <TextBlock Text="{Binding CountText}" Classes="caption"/>
              <TextBlock Text="{Binding ImportStatus}"
                         Classes="caption"
                         TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7">
              <Button Classes="ghost" Command="{Binding SyncCommand}" IsEnabled="{Binding !IsSyncing}"
                      ToolTip.Tip="从 HuggingFace / 魔搭 / Ollama 官方库拉取最新模型清单">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Classes="icon" Data="{StaticResource IconSpark}" Width="16" Height="16"/>
                  <TextBlock Text="同步" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button Classes="ghost" Command="{Binding AddCustomModelCommand}" IsEnabled="{Binding !IsImporting}"
                      ToolTip.Tip="手动填写模型名称与下载地址">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Classes="icon" Data="{StaticResource IconPlus}" Width="16" Height="16"/>
                  <TextBlock Text="自定义" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button Classes="primary" Command="{Binding ImportCommand}" IsEnabled="{Binding !IsImporting}"
                      ToolTip.Tip="把已下载的 GGUF 文件加入本机模型库">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Classes="icon" Data="{StaticResource IconFolder}" Width="16" Height="16"/>
                  <TextBlock Text="导入 GGUF" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>

          <views:ModelLegendView Margin="0,2,0,0"/>
        </StackPanel>
      </Border>

      <StackPanel Spacing="2" Margin="4,0,0,0">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Text="{Binding ProviderHint}" Classes="caption"/>
          <TextBlock Text="{Binding SyncSummaryText}" Classes="caption"/>
        </StackPanel>
        <TextBlock Text="{Binding SyncStatus}"
                   Classes="caption"
                   Foreground="{DynamicResource Accent}"
                   TextWrapping="Wrap"
                   IsVisible="{Binding HasSyncStatus}"/>
      </StackPanel>
    </StackPanel>

    <ScrollViewer Grid.Row="1" Classes="page" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="32,4,14,24">
        <ItemsControl ItemsSource="{Binding Cards}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ModelCardViewModel">
              <views:ModelCardView Width="306" Margin="0,0,16,16"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Classes="ghost"
                Content="{Binding LoadMoreText}"
                Command="{Binding LoadMoreCommand}"
                IsVisible="{Binding HasMore}"
                HorizontalAlignment="Center"
                Margin="0,4,0,8"/>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="1"
                IsVisible="{Binding IsEmpty}"
                HorizontalAlignment="Center"
                Margin="0,56,0,0"
                Spacing="8">
      <TextBlock Text="没有匹配的模型。"
                 Classes="h3"
                 HorizontalAlignment="Center"/>
      <TextBlock Text="{Binding ActiveFilterText}"
                 Classes="caption"
                 HorizontalAlignment="Center"
                 TextWrapping="Wrap"
                 MaxWidth="560"
                 TextAlignment="Center"/>
      <Button Classes="ghost"
              Content="重置筛选"
              Command="{Binding ResetFiltersCommand}"
              HorizontalAlignment="Center"
              Margin="0,6,0,0"/>
    </StackPanel>
  </Grid>
</UserControl>
