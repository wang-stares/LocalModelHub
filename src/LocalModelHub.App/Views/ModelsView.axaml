<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LocalModelHub.App.ViewModels"
             xmlns:views="using:LocalModelHub.App.Views"
             x:Class="LocalModelHub.App.Views.ModelsView"
             x:DataType="vm:ModelsViewModel">
  <Grid RowDefinitions="Auto,*">
    <!-- 三个二级内容不再占据侧边栏，统一收在模型库内部的标签带 -->
    <Border Grid.Row="0"
            Padding="32,8,32,12"
            BorderBrush="{DynamicResource StrokeSubtle}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*">
        <Border Classes="segmentHost" VerticalAlignment="Center">
          <ListBox Classes="segments"
                   ItemsSource="{Binding Tabs}"
                   SelectedIndex="{Binding TabIndex, Mode=TwoWay}">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
          </ListBox>
        </Border>
        <TextBlock Grid.Column="1"
                   Text="{Binding TabHint}"
                   Classes="caption"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Margin="16,0,0,0"/>
      </Grid>
    </Border>

    <Panel Grid.Row="1">
      <Panel IsVisible="{Binding IsInstalledTab}">
        <views:LibraryView DataContext="{Binding Library}"/>
      </Panel>
      <Panel IsVisible="{Binding IsRecommendTab}">
        <views:RecommendView DataContext="{Binding Recommend}"/>
      </Panel>
      <Panel IsVisible="{Binding IsStoreTab}">
        <views:StoreView DataContext="{Binding Store}"/>
      </Panel>
    </Panel>
  </Grid>
</UserControl>
