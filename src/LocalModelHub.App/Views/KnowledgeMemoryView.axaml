<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LocalModelHub.App.ViewModels"
             xmlns:views="using:LocalModelHub.App.Views"
             x:Class="LocalModelHub.App.Views.KnowledgeMemoryView"
             x:DataType="vm:KnowledgeMemoryViewModel">
  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0"
            Padding="32,8,32,12"
            BorderBrush="{DynamicResource StrokeSubtle}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*">
        <Border Classes="segmentHost" VerticalAlignment="Center">
          <ListBox Classes="segments"
                   ItemsSource="{Binding Tabs}"
                   SelectedIndex="{Binding TabIndex, Mode=TwoWay}">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
          </ListBox>
        </Border>
        <TextBlock Grid.Column="1"
                   Text="{Binding TabHint}"
                   Classes="caption"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Margin="16,0,0,0"/>
      </Grid>
    </Border>

    <Panel Grid.Row="1">
      <Panel IsVisible="{Binding IsKnowledgeTab}">
        <views:KnowledgeView DataContext="{Binding Knowledge}"/>
      </Panel>
      <Panel IsVisible="{Binding IsMemoryTab}">
        <views:MemoryView DataContext="{Binding Memory}"/>
      </Panel>
      <Panel IsVisible="{Binding IsSkillsTab}">
        <views:SkillsView DataContext="{Binding Skills}"/>
      </Panel>
    </Panel>
  </Grid>
</UserControl>
