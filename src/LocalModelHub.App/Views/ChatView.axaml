<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LocalModelHub.App.ViewModels"
             xmlns:controls="using:LocalModelHub.App.Views.Controls"
             x:Class="LocalModelHub.App.Views.ChatView"
             x:DataType="vm:ChatViewModel">
  <Grid Margin="32,12,32,20">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="{Binding SessionsWidth}"/>
      <ColumnDefinition Width="{Binding SessionsGap}"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- 会话列表：材质面板 -->
    <Border Grid.Column="0"
            IsVisible="{Binding !IsSessionsCollapsed}"
            Classes="glass"
            CornerRadius="16"
            Padding="12,14">
      <Grid RowDefinitions="Auto,*,Auto">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <StackPanel Spacing="1">
            <TextBlock Text="历史" Classes="eyebrow"/>
            <TextBlock Text="会话" Classes="h3" VerticalAlignment="Center"/>
          </StackPanel>
          <Button Grid.Column="1"
                  Classes="icon"
                  Command="{Binding NewSessionCommand}"
                  ToolTip.Tip="新建会话"
                  VerticalAlignment="Center">
            <Path Classes="icon" Data="{StaticResource IconPlus}" Width="16" Height="16"/>
          </Button>
          <Button Grid.Column="2"
                  Classes="icon"
                  Command="{Binding ToggleSessionsCommand}"
                  ToolTip.Tip="折叠历史对话"
                  VerticalAlignment="Center">
            <Path Classes="chev" Data="{StaticResource IconChevronLeft}" Width="13" Height="13"/>
          </Button>
        </Grid>
        <ListBox Grid.Row="1"
                 Classes="sessions"
                 Margin="0,12,0,0"
                 ItemsSource="{Binding Sessions}"
                 SelectedItem="{Binding SelectedSession, Mode=TwoWay}"
                 IsEnabled="{Binding !IsStreaming}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ChatSessionItemViewModel">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Title}"
                           FontSize="12.5"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="1"/>
                <TextBlock Text="{Binding TimeText}" Classes="caption"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Button Grid.Row="2"
                Classes="ghost"
                Content="删除当前会话"
                Command="{Binding DeleteCurrentSessionCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Margin="0,8,0,0"/>
      </Grid>
    </Border>

    <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto,Auto">
      <Border Grid.Row="0"
              BorderBrush="{DynamicResource StrokeSubtle}"
              BorderThickness="0,0,0,1"
              Padding="0,2,0,13">
        <Grid ColumnDefinitions="*,Auto">
          <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center" Margin="0,0,12,0">
            <TextBlock Text="{Binding ModelName}"
                       Classes="h3"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            <Border Grid.Column="1"
                    Classes="badge pill"
                    Classes.accent="{Binding IsReady}"
                    VerticalAlignment="Center"
                    Margin="9,0,0,0">
              <TextBlock Text="{Binding StatusText}"/>
            </Border>
          </Grid>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button Classes="icon"
                    IsVisible="{Binding IsSessionsCollapsed}"
                    Command="{Binding ToggleSessionsCommand}"
                    ToolTip.Tip="展开历史对话"
                    VerticalAlignment="Center">
              <Path Classes="chev" Data="{StaticResource IconChevronRight}" Width="13" Height="13"/>
            </Button>
            <Button Classes="icon" ToolTip.Tip="更多操作" VerticalAlignment="Center">
              <Path Classes="icon" Data="{StaticResource IconMore}"/>
              <Button.Flyout>
                <MenuFlyout>
                  <MenuItem Header="{Binding SessionsToggleTip}" Command="{Binding ToggleSessionsCommand}"/>
                  <MenuItem Header="打开 WebUI" Command="{Binding OpenWebUiCommand}" IsEnabled="{Binding IsReady}"/>
                  <MenuItem Header="导出为 Markdown" Command="{Binding ExportMarkdownCommand}" IsEnabled="{Binding HasMessages}"/>
                  <MenuItem Header="停止推理服务" Command="{Binding StopServerCommand}" IsEnabled="{Binding IsReady}"/>
                  <MenuItem Header="清空会话" Command="{Binding ClearCommand}" IsEnabled="{Binding HasMessages}"/>
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <ScrollViewer x:Name="MessagesScroll"
                    Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Margin="0,10,0,0">
        <ItemsControl x:Name="MessagesList"
                      ItemsSource="{Binding Messages}"
                      HorizontalAlignment="Center">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ChatMessageViewModel">
              <Grid Margin="0,7">
                <!-- 用户气泡：渐变强调色 -->
                <Border IsVisible="{Binding IsUser}"
                        HorizontalAlignment="Right"
                        MaxWidth="500"
                        Background="{StaticResource PrimaryGradient}"
                        CornerRadius="16,16,6,16"
                        Padding="16,11"
                        BoxShadow="0 4 14 0 #2A1E5BC0">
                  <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Button Grid.Column="0"
                              Classes="ghost"
                              Content="编辑"
                              Command="{Binding EditCommand}"
                              IsVisible="{Binding CanEdit}"
                              FontSize="10.5"
                              Padding="6,2"
                              MinHeight="0"
                              Foreground="#FFFFFF"
                              Background="Transparent"/>
                      <TextBlock Grid.Column="2"
                                 Text="{Binding RoleLabel}"
                                 FontSize="10.5"
                                 Foreground="#FFFFFF"
                                 Opacity="0.75"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{Binding DisplayText}"
                               TextWrapping="Wrap"
                               LineHeight="21"
                               Foreground="#FFFFFF"/>
                  </StackPanel>
                </Border>

                <!-- 助手气泡：卡片材质 -->
                <Border IsVisible="{Binding IsAssistant}"
                        HorizontalAlignment="Left"
                        MaxWidth="620"
                        Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource StrokeSubtle}"
                        BorderThickness="1"
                        CornerRadius="16,16,16,6"
                        Padding="16,11"
                        BoxShadow="0 1 2 0 #0A0B1220, 0 8 20 0 #0B0B1220">
                  <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding RoleLabel}" Classes="eyebrow" VerticalAlignment="Center"/>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                        <Button Classes="ghost"
                                Content="重新生成"
                                Command="{Binding RegenerateCommand}"
                                IsVisible="{Binding CanRegenerate}"
                                FontSize="10.5"
                                Padding="8,2"
                                MinHeight="0"/>
                        <Button Classes="ghost"
                                Content="{Binding SaveMemoryText}"
                                Command="{Binding SaveToMemoryCommand}"
                                IsVisible="{Binding CanSaveToMemory}"
                                IsEnabled="{Binding CanSaveAgain}"
                                FontSize="10.5"
                                Padding="8,2"
                                MinHeight="0"/>
                      </StackPanel>
                    </Grid>
                    <Expander IsVisible="{Binding HasReasoning}"
                              IsExpanded="{Binding IsReasoningExpanded, Mode=TwoWay}"
                              Padding="0"
                              Margin="0,2,0,2">
                      <Expander.Header>
                        <TextBlock Text="{Binding ReasoningHeaderText}"
                                   Classes="caption"
                                   Foreground="{DynamicResource AccentInk}"/>
                      </Expander.Header>
                      <Border Background="{DynamicResource CardSunkenBg}"
                              CornerRadius="10"
                              Padding="10,7"
                              Margin="0,4,0,0">
                        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                          <TextBlock Text="{Binding Reasoning}"
                                     Classes="caption"
                                     TextWrapping="Wrap"/>
                        </ScrollViewer>
                      </Border>
                    </Expander>
                    <controls:MarkdownView Markdown="{Binding DisplayText}"/>
                  </StackPanel>
                </Border>

                <!-- 工具轨迹 -->
                <Border IsVisible="{Binding IsTool}"
                        HorizontalAlignment="Left"
                        MaxWidth="560"
                        Background="{DynamicResource CardSunkenBg}"
                        BorderBrush="{DynamicResource StrokeSubtle}"
                        BorderThickness="1"
                        CornerRadius="11"
                        Padding="12,8">
                  <StackPanel Spacing="3">
                    <TextBlock Text="文件操作" Classes="eyebrow"/>
                    <TextBlock Text="{Binding DisplayText}"
                               Classes="caption mono"
                               TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <StackPanel Grid.Row="1"
                  IsVisible="{Binding !HasMessages}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="9">
        <Border Width="48" Height="48" CornerRadius="14" Background="{DynamicResource AccentSoft}"
                HorizontalAlignment="Center">
          <Path Data="{StaticResource IconChat}" Width="20" Height="20"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Fill="{DynamicResource AccentInk}"/>
        </Border>
        <TextBlock Text="和本地模型聊聊吧" Classes="h2" HorizontalAlignment="Center"/>
        <TextBlock Text="先在“我的模型”里启动一个模型，然后输入问题。"
                   Classes="muted"
                   HorizontalAlignment="Center"/>
      </StackPanel>

      <Border Grid.Row="2"
              Classes="card flat"
              CornerRadius="12"
              Margin="0,12,0,0"
              Padding="13,9">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto">
            <Border Classes="segmentHost" VerticalAlignment="Center">
              <ListBox Classes="segments"
                       ItemsSource="{Binding Modes}"
                       SelectedIndex="{Binding ModeIndex, Mode=TwoWay}">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
              </ListBox>
            </Border>
            <TextBlock Grid.Column="1"
                       Text="{Binding WorkspaceLabel}"
                       Classes="caption"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"
                       Margin="12,0,10,0"/>
            <Button Grid.Column="2"
                    Classes="ghost"
                    Content="打开"
                    Command="{Binding OpenWorkspaceCommand}"
                    IsVisible="{Binding HasWorkspace}"
                    Margin="0,0,6,0"/>
            <Button Grid.Column="3"
                    Classes="ghost"
                    Content="选择文件夹"
                    Command="{Binding ChooseWorkspaceCommand}"/>
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding ModeHint}" Classes="caption" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center"
                        IsVisible="{Binding HasWorkspace}">
              <CheckBox Content="多 Agent"
                        IsChecked="{Binding MultiAgentEnabled, Mode=TwoWay}"
                        ToolTip.Tip="目标模式下启用 Planner → Coder → Reviewer 串行协作：独立评审角色只依据工具轨迹与真实补丁判断，未通过时把具体问题交回 Coder 返工。"/>
              <CheckBox Content="允许命令"
                        IsChecked="{Binding AllowCommands, Mode=TwoWay}"
                        ToolTip.Tip="允许模型运行白名单内的构建 / 测试命令（dotnet test、npm test、pytest 等）。命令在工作文件夹内执行，其它命令会被拒绝。"/>
            </StackPanel>
          </Grid>
          <TextBlock Text="{Binding KnowledgeStatus}"
                     Classes="caption"
                     Foreground="{DynamicResource AccentInk}"
                     IsVisible="{Binding HasKnowledgeStatus}"/>
        </StackPanel>
      </Border>

      <Border Grid.Row="3"
              Classes="composer"
              Margin="0,14,0,0">
        <Grid ColumnDefinitions="*,Auto">
          <TextBox x:Name="InputBox"
                   Classes="chatInput"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   MinHeight="40"
                   MaxHeight="140"
                   VerticalContentAlignment="Center"
                   Watermark="输入消息，Enter 发送，Shift + Enter 换行"
                   Text="{Binding Input, Mode=TwoWay}"
                   KeyDown="OnInputKeyDown"/>
          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="8"
                      Margin="10,0,0,0"
                      VerticalAlignment="Center">
            <Button Classes="ghost" Content="停止" Command="{Binding StopCommand}" IsVisible="{Binding IsStreaming}"/>
            <Button Classes="primary" Command="{Binding SendCommand}" IsEnabled="{Binding CanSend}" MinWidth="96">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Path Classes="icon" Data="{StaticResource IconSend}" Width="16" Height="16"/>
                <TextBlock Text="发送" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
