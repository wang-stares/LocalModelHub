<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LocalModelHub.App.ViewModels"
        x:Class="LocalModelHub.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="星坞 · 本地模型启动器"
        Width="1200"
        Height="780"
        MinWidth="1000"
        MinHeight="660"
        WindowStartupLocation="CenterScreen"
        TransparencyLevelHint="Mica, AcrylicBlur, Blur, Transparent"
        Background="Transparent"
        Icon="/Assets/app.ico">
  <Grid x:Name="ShellRoot" Classes="shell">
    <!-- 材质光晕：为半透明面板提供可透出的层次，不参与命中测试；系统磨砂生效时隐藏 -->
    <Border x:Name="BloomLayer" Background="{DynamicResource BloomBrush}" IsHitTestVisible="False"/>
    <Border x:Name="BloomLayerAlt" Background="{DynamicResource BloomBrushAlt}" IsHitTestVisible="False"/>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{Binding NavColumnWidth}"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- 侧边栏：六个工作区，二级内容不再挂在导航树里 -->
      <Border Grid.Column="0"
              Background="{DynamicResource NavBg}"
              BorderBrush="{DynamicResource MicaStroke}"
              BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*,Auto" Margin="14,16,14,14">
          <StackPanel Orientation="Horizontal" Spacing="11" Margin="6,2,4,20" IsVisible="{Binding !IsNavCollapsed}">
            <Border Width="38" Height="38" Classes="brand">
              <TextBlock Text="星"
                         FontWeight="Bold"
                         FontSize="17"
                         Foreground="{DynamicResource OnAccent}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
            </Border>
            <StackPanel Spacing="1" VerticalAlignment="Center">
              <TextBlock Text="星坞" FontSize="13.5" FontWeight="SemiBold"/>
              <TextBlock Text="本地模型启动器" Classes="caption"/>
            </StackPanel>
          </StackPanel>
          <Border Width="38" Height="38" Classes="brand"
                  HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,20"
                  IsVisible="{Binding IsNavCollapsed}"
                  ToolTip.Tip="星坞 · 本地模型启动器">
            <TextBlock Text="星"
                       FontWeight="Bold"
                       FontSize="17"
                       Foreground="{DynamicResource OnAccent}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
          </Border>

          <Grid Grid.Row="1" RowDefinitions="Auto,*">
            <Grid ColumnDefinitions="*,Auto" Margin="4,0,0,0">
              <Button Grid.Column="1"
                      Classes="icon"
                      Command="{Binding ToggleNavCommand}"
                      ToolTip.Tip="{Binding NavToggleTip}"
                      HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                  <Path Classes="chev" Data="{StaticResource IconChevronRight}" Width="14" Height="14" StrokeThickness="1.6" IsVisible="{Binding IsNavCollapsed}"/>
                  <Path Classes="chev" Data="{StaticResource IconChevronLeft}" Width="14" Height="14" StrokeThickness="1.6" IsVisible="{Binding !IsNavCollapsed}"/>
                </StackPanel>
              </Button>
            </Grid>
            <StackPanel Grid.Row="1" Spacing="2" Margin="0,8,0,0">
              <Button Classes="nav" Classes.active="{Binding IsDashboardActive}" Command="{Binding OpenRouteCommand}" CommandParameter="dashboard" ToolTip.Tip="工作台" HorizontalContentAlignment="{Binding NavAlignment}">
                <StackPanel Orientation="Horizontal" Spacing="11">
                  <TextBlock Classes="navGlyph" Text="&#xE80F;"/>
                  <TextBlock Text="工作台" VerticalAlignment="Center" IsVisible="{Binding IsNavExpanded}"/>
                </StackPanel>
              </Button>
              <Button Classes="nav" Classes.active="{Binding IsModelsActive}" Command="{Binding OpenRouteCommand}" CommandParameter="models" ToolTip.Tip="模型库：已下载 / 推荐 / 商店" HorizontalContentAlignment="{Binding NavAlignment}">
                <StackPanel Orientation="Horizontal" Spacing="11">
                  <TextBlock Classes="navGlyph" Text="&#xE8B7;"/>
                  <TextBlock Text="模型库" VerticalAlignment="Center" IsVisible="{Binding IsNavExpanded}"/>
                </StackPanel>
              </Button>
              <Button Classes="nav" Classes.active="{Binding IsChatActive}" Command="{Binding OpenRouteCommand}" CommandParameter="chat" ToolTip.Tip="对话" HorizontalContentAlignment="{Binding NavAlignment}">
                <StackPanel Orientation="Horizontal" Spacing="11">
                  <TextBlock Classes="navGlyph" Text="&#xE8BD;"/>
                  <TextBlock Text="对话" VerticalAlignment="Center" IsVisible="{Binding IsNavExpanded}"/>
                </StackPanel>
              </Button>
              <Button Classes="nav" Classes.active="{Binding IsKnowledgeActive}" Command="{Binding OpenRouteCommand}" CommandParameter="knowledge" ToolTip.Tip="知识：知识库 / 记忆 / 技能" HorizontalContentAlignment="{Binding NavAlignment}">
                <StackPanel Orientation="Horizontal" Spacing="11">
                  <TextBlock Classes="navGlyph" Text="&#xE8F1;"/>
                  <TextBlock Text="知识" VerticalAlignment="Center" IsVisible="{Binding IsNavExpanded}"/>
                </StackPanel>
              </Button>

              <Button Classes="nav" Classes.active="{Binding IsPhoneActive}" Command="{Binding OpenRouteCommand}" CommandParameter="phone" ToolTip.Tip="手机：手机收发消息、微信与 OpenClaw 接入" HorizontalContentAlignment="{Binding NavAlignment}">
                <StackPanel Orientation="Horizontal" Spacing="11">
                  <TextBlock Classes="navGlyph" Text="&#xE717;"/>
                  <TextBlock Text="手机" VerticalAlignment="Center" IsVisible="{Binding IsNavExpanded}"/>
                </StackPanel>
              </Button>

              <Border Classes="navDivider" Height="1" Background="{DynamicResource StrokeSubtle}" Margin="6,10"/>

              <Button Classes="nav" Classes.active="{Binding IsSettingsActive}" Command="{Binding OpenRouteCommand}" CommandParameter="settings" ToolTip.Tip="设置" HorizontalContentAlignment="{Binding NavAlignment}">
                <StackPanel Orientation="Horizontal" Spacing="11">
                  <TextBlock Classes="navGlyph" Text="&#xE713;"/>
                  <TextBlock Text="设置" VerticalAlignment="Center" IsVisible="{Binding IsNavExpanded}"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>

          <StackPanel Grid.Row="2" Spacing="9" IsVisible="{Binding !IsNavCollapsed}">
            <Border Classes="glass" Padding="13">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Border Width="18" Height="18" CornerRadius="999" Background="{DynamicResource SuccessSoft}"
                          IsVisible="{Binding IsServerRunning}" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource Success}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <Border Width="18" Height="18" CornerRadius="999" Background="{DynamicResource StrokeSubtle}"
                          IsVisible="{Binding !IsServerRunning}" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <TextBlock Grid.Column="1" Text="{Binding ServerSummary}" Classes="caption" VerticalAlignment="Center" Margin="7,0,0,0"/>
                  <TextBlock Grid.Column="2" Text="服务" Classes="eyebrow" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="{Binding LoadedModelName}" Classes="muted" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                <Button Classes="soft" Content="打开 WebUI" Command="{Binding OpenWebUiCommand}" IsEnabled="{Binding IsServerRunning}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                <Button Classes="ghost" Content="停止服务" Command="{Binding StopServerCommand}" IsEnabled="{Binding CanStopServer}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
              </StackPanel>
            </Border>
            <TextBlock Text="{Binding VersionText}"
                       Classes="caption"
                       HorizontalAlignment="Center"
                       MaxWidth="212"
                       TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding VersionText}"/>
          </StackPanel>
          <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                      IsVisible="{Binding IsNavCollapsed}">
            <Ellipse Width="8" Height="8" Fill="{DynamicResource Success}" IsVisible="{Binding IsServerRunning}"/>
            <Ellipse Width="8" Height="8" Fill="{DynamicResource TextMuted}" IsVisible="{Binding !IsServerRunning}"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- 内容列：顶栏只保留工作区标题与服务状态，页面自己负责层级 -->
      <Grid Grid.Column="1" Background="{DynamicResource ContentSurface}">
        <Grid MaxWidth="1520" HorizontalAlignment="Stretch" RowDefinitions="Auto,*">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="32,22,32,6">
            <StackPanel Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="{Binding HeaderTitle}" Classes="h1"/>
              <TextBlock Text="{Binding HeaderSubtitle}" Classes="muted"/>
            </StackPanel>
            <Border Grid.Column="1"
                    Classes="glass chip"
                    Padding="11,6"
                    VerticalAlignment="Center"
                    IsVisible="{Binding IsServerRunning}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="16" Height="16" CornerRadius="999" Background="{DynamicResource SuccessSoft}" VerticalAlignment="Center">
                  <Ellipse Width="6" Height="6" Fill="{DynamicResource Success}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding LoadedModelName}" Classes="caption" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
          </Grid>

          <ContentControl x:Name="PageHost"
                          Grid.Row="1"
                          Content="{Binding CurrentPage}"
                          RenderTransform="translate(0px,0px)">
            <ContentControl.Transitions>
              <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.24"/>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.28" Easing="CubicEaseOut"/>
              </Transitions>
            </ContentControl.Transitions>
          </ContentControl>
        </Grid>
      </Grid>
    </Grid>

    <Border Background="{DynamicResource OverlayBg}" IsVisible="{Binding IsBusy}">
      <Border Classes="dialogCard"
              Background="{DynamicResource CardBg}"
              BorderBrush="{DynamicResource Stroke}"
              BorderThickness="1"
              Padding="30,26"
              Width="400"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel Spacing="16">
          <TextBlock Text="正在准备本地推理" Classes="h3" HorizontalAlignment="Center"/>
          <Border ClipToBounds="True" Height="4">
            <ProgressBar IsIndeterminate="True" Height="4"/>
          </Border>
          <TextBlock Text="{Binding BusyText}" TextAlignment="Center" TextWrapping="Wrap" Classes="muted"/>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
