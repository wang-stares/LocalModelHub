<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LocalModelHub.App.ViewModels"
             xmlns:views="using:LocalModelHub.App.Views"
             x:Class="LocalModelHub.App.App"
             RequestedThemeVariant="Default">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppBg" Color="#F2F3F5"/>
          <SolidColorBrush x:Key="SidebarBg" Color="#F7F8FA"/>
          <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="CardHoverBg" Color="#FAFBFD"/>
          <SolidColorBrush x:Key="InputBg" Color="#F4F5F7"/>
          <SolidColorBrush x:Key="SegBg" Color="#F0F1F4"/>
          <SolidColorBrush x:Key="SegSelectedBg" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="Stroke" Color="#EBEDF0"/>
          <SolidColorBrush x:Key="StrokeStrong" Color="#DCE0E5"/>
          <SolidColorBrush x:Key="TextPrimary" Color="#0E1116"/>
          <SolidColorBrush x:Key="TextSecondary" Color="#5F6673"/>
          <SolidColorBrush x:Key="TextMuted" Color="#9AA0A9"/>
          <SolidColorBrush x:Key="Accent" Color="#3482FF"/>
          <SolidColorBrush x:Key="AccentHover" Color="#4B90FF"/>
          <SolidColorBrush x:Key="AccentPressed" Color="#2A6FDB"/>
          <SolidColorBrush x:Key="AccentSoft" Color="#E8F1FF"/>
          <SolidColorBrush x:Key="AccentSoftHover" Color="#D9E8FF"/>
          <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="AvatarBg" Color="#E8F1FF"/>
          <SolidColorBrush x:Key="Success" Color="#22B573"/>
          <SolidColorBrush x:Key="SuccessSoft" Color="#E6F7EF"/>
          <SolidColorBrush x:Key="Warning" Color="#E8952C"/>
          <SolidColorBrush x:Key="WarningSoft" Color="#FFF4E0"/>
          <SolidColorBrush x:Key="Danger" Color="#F55A5A"/>
          <SolidColorBrush x:Key="DangerSoft" Color="#FEECEC"/>
          <SolidColorBrush x:Key="DangerHover" Color="#FBE0E0"/>
          <SolidColorBrush x:Key="ProgressBg" Color="#EFF1F4"/>
          <SolidColorBrush x:Key="OverlayBg" Color="#D9F2F3F5"/>

          <SolidColorBrush x:Key="BadgeNeutralBg" Color="#F2F3F5"/>
          <SolidColorBrush x:Key="BadgeNeutralFg" Color="#6B7280"/>
          <SolidColorBrush x:Key="BadgeCnBg" Color="#FFF0E4"/>
          <SolidColorBrush x:Key="BadgeCnFg" Color="#C8620F"/>
          <SolidColorBrush x:Key="BadgeIntlBg" Color="#E8F1FF"/>
          <SolidColorBrush x:Key="BadgeIntlFg" Color="#1E6FE8"/>
          <SolidColorBrush x:Key="BadgeLocalBg" Color="#F2F3F5"/>
          <SolidColorBrush x:Key="BadgeLocalFg" Color="#6B7280"/>
          <SolidColorBrush x:Key="FitPerfectBg" Color="#E6F7EF"/>
          <SolidColorBrush x:Key="FitPerfectFg" Color="#14925C"/>
          <SolidColorBrush x:Key="FitGoodBg" Color="#E8F1FF"/>
          <SolidColorBrush x:Key="FitGoodFg" Color="#1E6FE8"/>
          <SolidColorBrush x:Key="FitPlayableBg" Color="#FFF4E0"/>
          <SolidColorBrush x:Key="FitPlayableFg" Color="#B26A00"/>
          <SolidColorBrush x:Key="FitTightBg" Color="#FFEEE6"/>
          <SolidColorBrush x:Key="FitTightFg" Color="#C0562A"/>
          <SolidColorBrush x:Key="FitBadBg" Color="#FEECEC"/>
          <SolidColorBrush x:Key="FitBadFg" Color="#D13737"/>

          <SolidColorBrush x:Key="TileCpuBg" Color="#E8F1FF"/>
          <SolidColorBrush x:Key="TileCpuFg" Color="#2067D4"/>
          <SolidColorBrush x:Key="TileGpuBg" Color="#F1EBFF"/>
          <SolidColorBrush x:Key="TileGpuFg" Color="#6E45D0"/>
          <SolidColorBrush x:Key="TileRamBg" Color="#E6F7EF"/>
          <SolidColorBrush x:Key="TileRamFg" Color="#14925C"/>
          <SolidColorBrush x:Key="TileDiskBg" Color="#FFF4E0"/>
          <SolidColorBrush x:Key="TileDiskFg" Color="#B26A00"/>

          <Color x:Key="SystemAccentColor">#3482FF</Color>
          <Color x:Key="SystemAccentColorLight1">#4B90FF</Color>
          <Color x:Key="SystemAccentColorLight2">#6AA3FF</Color>
          <Color x:Key="SystemAccentColorLight3">#8FB8FF</Color>
          <Color x:Key="SystemAccentColorDark1">#2A6FDB</Color>
          <Color x:Key="SystemAccentColorDark2">#245CB5</Color>
          <Color x:Key="SystemAccentColorDark3">#1E4A91</Color>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppBg" Color="#101114"/>
          <SolidColorBrush x:Key="SidebarBg" Color="#0D0E11"/>
          <SolidColorBrush x:Key="CardBg" Color="#1B1D23"/>
          <SolidColorBrush x:Key="CardHoverBg" Color="#22252C"/>
          <SolidColorBrush x:Key="InputBg" Color="#22252C"/>
          <SolidColorBrush x:Key="SegBg" Color="#17191E"/>
          <SolidColorBrush x:Key="SegSelectedBg" Color="#2C3038"/>
          <SolidColorBrush x:Key="Stroke" Color="#262931"/>
          <SolidColorBrush x:Key="StrokeStrong" Color="#333844"/>
          <SolidColorBrush x:Key="TextPrimary" Color="#F2F4F7"/>
          <SolidColorBrush x:Key="TextSecondary" Color="#A3A9B3"/>
          <SolidColorBrush x:Key="TextMuted" Color="#6C7280"/>
          <SolidColorBrush x:Key="Accent" Color="#4D8DFF"/>
          <SolidColorBrush x:Key="AccentHover" Color="#6AA3FF"/>
          <SolidColorBrush x:Key="AccentPressed" Color="#3B7BEF"/>
          <SolidColorBrush x:Key="AccentSoft" Color="#1B2A44"/>
          <SolidColorBrush x:Key="AccentSoftHover" Color="#223754"/>
          <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="AvatarBg" Color="#1F2A3C"/>
          <SolidColorBrush x:Key="Success" Color="#3DDC97"/>
          <SolidColorBrush x:Key="SuccessSoft" Color="#123326"/>
          <SolidColorBrush x:Key="Warning" Color="#F7B955"/>
          <SolidColorBrush x:Key="WarningSoft" Color="#332713"/>
          <SolidColorBrush x:Key="Danger" Color="#FF7A85"/>
          <SolidColorBrush x:Key="DangerSoft" Color="#3A1B20"/>
          <SolidColorBrush x:Key="DangerHover" Color="#4A2229"/>
          <SolidColorBrush x:Key="ProgressBg" Color="#262A32"/>
          <SolidColorBrush x:Key="OverlayBg" Color="#D9101214"/>

          <SolidColorBrush x:Key="BadgeNeutralBg" Color="#262A32"/>
          <SolidColorBrush x:Key="BadgeNeutralFg" Color="#93A1B5"/>
          <SolidColorBrush x:Key="BadgeCnBg" Color="#2E2118"/>
          <SolidColorBrush x:Key="BadgeCnFg" Color="#FFB077"/>
          <SolidColorBrush x:Key="BadgeIntlBg" Color="#17283C"/>
          <SolidColorBrush x:Key="BadgeIntlFg" Color="#7FB6FF"/>
          <SolidColorBrush x:Key="BadgeLocalBg" Color="#262A32"/>
          <SolidColorBrush x:Key="BadgeLocalFg" Color="#93A1B5"/>
          <SolidColorBrush x:Key="FitPerfectBg" Color="#123326"/>
          <SolidColorBrush x:Key="FitPerfectFg" Color="#4AE3A0"/>
          <SolidColorBrush x:Key="FitGoodBg" Color="#16293F"/>
          <SolidColorBrush x:Key="FitGoodFg" Color="#79B0FF"/>
          <SolidColorBrush x:Key="FitPlayableBg" Color="#332713"/>
          <SolidColorBrush x:Key="FitPlayableFg" Color="#F7B955"/>
          <SolidColorBrush x:Key="FitTightBg" Color="#33231C"/>
          <SolidColorBrush x:Key="FitTightFg" Color="#FF9E6B"/>
          <SolidColorBrush x:Key="FitBadBg" Color="#3A1B20"/>
          <SolidColorBrush x:Key="FitBadFg" Color="#FF7A85"/>

          <SolidColorBrush x:Key="TileCpuBg" Color="#1B2A44"/>
          <SolidColorBrush x:Key="TileCpuFg" Color="#7FB6FF"/>
          <SolidColorBrush x:Key="TileGpuBg" Color="#2A2140"/>
          <SolidColorBrush x:Key="TileGpuFg" Color="#C0A6FF"/>
          <SolidColorBrush x:Key="TileRamBg" Color="#123326"/>
          <SolidColorBrush x:Key="TileRamFg" Color="#4AE3A0"/>
          <SolidColorBrush x:Key="TileDiskBg" Color="#332713"/>
          <SolidColorBrush x:Key="TileDiskFg" Color="#F7B955"/>

          <Color x:Key="SystemAccentColor">#4D8DFF</Color>
          <Color x:Key="SystemAccentColorLight1">#6AA3FF</Color>
          <Color x:Key="SystemAccentColorLight2">#8FBAFF</Color>
          <Color x:Key="SystemAccentColorLight3">#B3D1FF</Color>
          <Color x:Key="SystemAccentColorDark1">#3B7BEF</Color>
          <Color x:Key="SystemAccentColorDark2">#2F65C9</Color>
          <Color x:Key="SystemAccentColorDark3">#2553A6</Color>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <LinearGradientBrush x:Key="LogoGradient" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#5B9BFF" Offset="0"/>
        <GradientStop Color="#2F6BE8" Offset="1"/>
      </LinearGradientBrush>

      <StreamGeometry x:Key="IconHome">M3.5,11 L12,3.5 L20.5,11 M6,9.2 V20.5 H18 V9.2</StreamGeometry>
      <StreamGeometry x:Key="IconSpark">M12,3.5 L13.9,8.9 L19.5,10.8 L13.9,12.7 L12,18.1 L10.1,12.7 L4.5,10.8 L10.1,8.9 Z</StreamGeometry>
      <StreamGeometry x:Key="IconStore">M5.5,8.5 H18.5 L17.6,20.5 H6.4 Z M9.3,8.5 V6.6 A2.7,2.7 0 0 1 14.7,6.6 V8.5</StreamGeometry>
      <StreamGeometry x:Key="IconFolder">M3.5,6.5 H9.3 L11.4,8.7 H20.5 V19.5 H3.5 Z</StreamGeometry>
      <StreamGeometry x:Key="IconChat">M3.8,5.5 H20.2 V16.3 H12.4 L8.3,20.2 V16.3 H3.8 Z</StreamGeometry>
      <StreamGeometry x:Key="IconSliders">M4,8 H20 M4,16 H20 M5.9,8 A2.1,2.1 0 1 0 10.1,8 A2.1,2.1 0 1 0 5.9,8 M13.9,16 A2.1,2.1 0 1 0 18.1,16 A2.1,2.1 0 1 0 13.9,16</StreamGeometry>
      <StreamGeometry x:Key="IconPlay">M8.2,5.5 L18.3,12 L8.2,18.5 Z</StreamGeometry>
      <StreamGeometry x:Key="IconDownload">M12,4 V15 M7.8,10.7 L12,15 L16.2,10.7 M5,19.5 H19</StreamGeometry>
      <StreamGeometry x:Key="IconSend">M4,12 L20,4 L15.5,20 L11.6,13.6 L4,12 Z M11.6,13.6 L20,4</StreamGeometry>
      <StreamGeometry x:Key="IconPlus">M12,5 V19 M5,12 H19</StreamGeometry>
      <StreamGeometry x:Key="IconTrash">M4,7 H20 M9,7 V4.8 H15 V7 M6.4,7 L7.4,20 H16.6 L17.6,7 M10,11 V16 M14,11 V16</StreamGeometry>
      <StreamGeometry x:Key="IconMemory">M6.5,4 H17.5 V20 L12,16.2 L6.5,20 Z</StreamGeometry>
      <StreamGeometry x:Key="IconBook">M4,6 C6.5,4.8 9.5,4.8 12,6.4 C14.5,4.8 17.5,4.8 20,6 V18.4 C17.5,17.2 14.5,17.2 12,18.8 C9.5,17.2 6.5,17.2 4,18.4 Z M12,6.4 V18.8</StreamGeometry>
      <StreamGeometry x:Key="IconPin">M12,3.5 A4.5,4.5 0 0 1 16.5,8 C16.5,10.6 13.9,12.4 12,16 C10.1,12.4 7.5,10.6 7.5,8 A4.5,4.5 0 0 1 12,3.5 Z M12,16 V20.5</StreamGeometry>
      <StreamGeometry x:Key="IconEdit">M4.5,19.5 H19.5 M6.5,17.5 L6.5,15.6 L15.8,6.3 L17.7,8.2 L8.4,17.5 Z</StreamGeometry>
    </ResourceDictionary>
  </Application.Resources>

  <Application.DataTemplates>
    <DataTemplate DataType="vm:DashboardViewModel">
      <views:DashboardView/>
    </DataTemplate>
    <DataTemplate DataType="vm:ModelsViewModel">
      <views:ModelsView/>
    </DataTemplate>
    <DataTemplate DataType="vm:RecommendViewModel">
      <views:RecommendView/>
    </DataTemplate>
    <DataTemplate DataType="vm:StoreViewModel">
      <views:StoreView/>
    </DataTemplate>
    <DataTemplate DataType="vm:LibraryViewModel">
      <views:LibraryView/>
    </DataTemplate>
    <DataTemplate DataType="vm:ChatViewModel">
      <views:ChatView/>
    </DataTemplate>
    <DataTemplate DataType="vm:KnowledgeMemoryViewModel">
      <views:KnowledgeMemoryView/>
    </DataTemplate>
    <DataTemplate DataType="vm:KnowledgeViewModel">
      <views:KnowledgeView/>
    </DataTemplate>
    <DataTemplate DataType="vm:MemoryViewModel">
      <views:MemoryView/>
    </DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel">
      <views:SettingsView/>
    </DataTemplate>
    <DataTemplate DataType="vm:ModelCardViewModel">
      <views:ModelCardView/>
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme/>

    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource AppBg}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, Microsoft YaHei"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="25"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.h3">
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style Selector="TextBlock.releaseHeading">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,10,0,2"/>
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace"/>
    </Style>

    <Style Selector="Border.codeBlock">
      <Setter Property="Background" Value="{DynamicResource InputBg}"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="Margin" Value="0,2"/>
    </Style>

    <Style Selector="ListBox.sessions">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="ListBox.sessions ListBoxItem">
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Margin" Value="0,0,0,3"/>
    </Style>
    <Style Selector="ListBox.sessions ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SegBg}"/>
    </Style>
    <Style Selector="ListBox.sessions ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
    </Style>

    <Style Selector="Path.icon">
      <Setter Property="Width" Value="17"/>
      <Setter Property="Height" Value="17"/>
      <Setter Property="Stretch" Value="Uniform"/>
      <Setter Property="StrokeThickness" Value="1.7"/>
      <Setter Property="StrokeLineCap" Value="Round"/>
      <Setter Property="StrokeJoin" Value="Round"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.nav Path.icon">
      <Setter Property="Stroke" Value="{DynamicResource TextSecondary}"/>
    </Style>
    <Style Selector="Button.nav:pointerover Path.icon">
      <Setter Property="Stroke" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style Selector="Button.nav.active Path.icon">
      <Setter Property="Stroke" Value="{DynamicResource Accent}"/>
    </Style>
    <Style Selector="Button.nav.active:pointerover Path.icon">
      <Setter Property="Stroke" Value="{DynamicResource Accent}"/>
    </Style>
    <Style Selector="Button.icon Path.icon">
      <Setter Property="Stroke" Value="{DynamicResource TextSecondary}"/>
    </Style>
    <Style Selector="Button.icon:pointerover Path.icon">
      <Setter Property="Stroke" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style Selector="Button.primary Path.icon">
      <Setter Property="Stroke" Value="{DynamicResource OnAccent}"/>
      <Setter Property="StrokeThickness" Value="1.9"/>
    </Style>
    <Style Selector="Button.ghost Path.icon">
      <Setter Property="Stroke" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style Selector="TextBlock.score">
      <Setter Property="FontSize" Value="58"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
      <Setter Property="LineHeight" Value="62"/>
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="18"/>
      <Setter Property="Padding" Value="18"/>
    </Style>
    <Style Selector="Border.cardHover:pointerover">
      <Setter Property="Background" Value="{DynamicResource CardHoverBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource StrokeStrong}"/>
    </Style>

    <Style Selector="Border.badge">
      <Setter Property="Background" Value="{DynamicResource BadgeNeutralBg}"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="8,2"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.badge TextBlock">
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="Foreground" Value="{DynamicResource BadgeNeutralFg}"/>
    </Style>
    <Style Selector="Border.badge.pill">
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="Padding" Value="10,3"/>
    </Style>
    <Style Selector="Border.badge.cn">
      <Setter Property="Background" Value="{DynamicResource BadgeCnBg}"/>
    </Style>
    <Style Selector="Border.badge.cn TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource BadgeCnFg}"/>
    </Style>
    <Style Selector="Border.badge.intl">
      <Setter Property="Background" Value="{DynamicResource BadgeIntlBg}"/>
    </Style>
    <Style Selector="Border.badge.intl TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource BadgeIntlFg}"/>
    </Style>
    <Style Selector="Border.badge.local">
      <Setter Property="Background" Value="{DynamicResource BadgeLocalBg}"/>
    </Style>
    <Style Selector="Border.badge.local TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource BadgeLocalFg}"/>
    </Style>
    <Style Selector="Border.badge.capability">
      <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
    </Style>
    <Style Selector="Border.badge.capability TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
    </Style>
    <Style Selector="Border.badge.fitPerfect">
      <Setter Property="Background" Value="{DynamicResource FitPerfectBg}"/>
    </Style>
    <Style Selector="Border.badge.fitPerfect TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource FitPerfectFg}"/>
    </Style>
    <Style Selector="Border.badge.fitGood">
      <Setter Property="Background" Value="{DynamicResource FitGoodBg}"/>
    </Style>
    <Style Selector="Border.badge.fitGood TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource FitGoodFg}"/>
    </Style>
    <Style Selector="Border.badge.fitPlayable">
      <Setter Property="Background" Value="{DynamicResource FitPlayableBg}"/>
    </Style>
    <Style Selector="Border.badge.fitPlayable TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource FitPlayableFg}"/>
    </Style>
    <Style Selector="Border.badge.fitTight">
      <Setter Property="Background" Value="{DynamicResource FitTightBg}"/>
    </Style>
    <Style Selector="Border.badge.fitTight TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource FitTightFg}"/>
    </Style>
    <Style Selector="Border.badge.fitBad">
      <Setter Property="Background" Value="{DynamicResource FitBadBg}"/>
    </Style>
    <Style Selector="Border.badge.fitBad TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource FitBadFg}"/>
    </Style>
    <Style Selector="Border.badge.accent">
      <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
    </Style>
    <Style Selector="Border.badge.accent TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
    </Style>

    <Style Selector="Border.tile">
      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style Selector="Border.tile TextBlock">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace"/>
    </Style>
    <Style Selector="Border.tile.cpu">
      <Setter Property="Background" Value="{DynamicResource TileCpuBg}"/>
    </Style>
    <Style Selector="Border.tile.cpu TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TileCpuFg}"/>
    </Style>
    <Style Selector="Border.tile.gpu">
      <Setter Property="Background" Value="{DynamicResource TileGpuBg}"/>
    </Style>
    <Style Selector="Border.tile.gpu TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TileGpuFg}"/>
    </Style>
    <Style Selector="Border.tile.ram">
      <Setter Property="Background" Value="{DynamicResource TileRamBg}"/>
    </Style>
    <Style Selector="Border.tile.ram TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TileRamFg}"/>
    </Style>
    <Style Selector="Border.tile.disk">
      <Setter Property="Background" Value="{DynamicResource TileDiskBg}"/>
    </Style>
    <Style Selector="Border.tile.disk TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TileDiskFg}"/>
    </Style>

    <Style Selector="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="MinHeight" Value="34"/>
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="20,9"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="999"/>
    </Style>
    <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Accent}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="999"/>
    </Style>
    <Style Selector="Button.primary TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentPressed}"/>
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Opacity" Value="0.45"/>
    </Style>

    <Style Selector="Button.ghost">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="999"/>
    </Style>
    <Style Selector="Button.ghost /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{DynamicResource StrokeStrong}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="999"/>
    </Style>
    <Style Selector="Button.ghost TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
