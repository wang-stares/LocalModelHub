      <LinearGradientBrush x:Key="LogoGradient" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#4A88F2" Offset="0"/>
        <GradientStop Color="#2F6BE8" Offset="1"/>
      </LinearGradientBrush>

      <!-- 强调色渐变：主按钮、评分数字、品牌块统一使用，避免纯色块显得扁平 -->
      <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#3D7AF0" Offset="0"/>
        <GradientStop Color="#2B6DE8" Offset="1"/>
      </LinearGradientBrush>
      <!-- 顶部高光：模拟材质的受光面 -->
      <LinearGradientBrush x:Key="TopSheen" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#16FFFFFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
      </LinearGradientBrush>

