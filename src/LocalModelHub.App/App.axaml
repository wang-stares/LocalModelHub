<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LocalModelHub.App.ViewModels"
             xmlns:views="using:LocalModelHub.App.Views"
             x:Class="LocalModelHub.App.App"
             RequestedThemeVariant="Default">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <!-- 材质底：窗口不再是一块纯色，而是带冷调渐变的桌面底板 -->
          <LinearGradientBrush x:Key="AppBg" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#F9FAFE" Offset="0"/>
            <GradientStop Color="#F1F3F9" Offset="0.48"/>
            <GradientStop Color="#E8ECF6" Offset="1"/>
          </LinearGradientBrush>
          <RadialGradientBrush x:Key="BloomBrush" Center="88%,4%" GradientOrigin="88%,4%" RadiusX="72%" RadiusY="86%">
            <GradientStop Color="#243482FF" Offset="0"/>
            <GradientStop Color="#003482FF" Offset="1"/>
          </RadialGradientBrush>
          <RadialGradientBrush x:Key="BloomBrushAlt" Center="4%,96%" GradientOrigin="4%,96%" RadiusX="64%" RadiusY="76%">
            <GradientStop Color="#144D8DFF" Offset="0"/>
            <GradientStop Color="#004D8DFF" Offset="1"/>
          </RadialGradientBrush>
          <!-- 半透明材质层：叠在渐变底上形成 Mica / 亚克力质感 -->
          <SolidColorBrush x:Key="MicaBg" Color="#A6FBFCFF"/>
          <SolidColorBrush x:Key="MicaStroke" Color="#1AFFFFFF"/>
          <!-- 内容底与侧栏底：压在半透明磨砂上，避免桌面壁纸透进正文区域 -->
          <SolidColorBrush x:Key="ContentSurface" Color="#F0F7F9FC"/>
          <SolidColorBrush x:Key="NavBg" Color="#F5FBFCFF"/>
          <SolidColorBrush x:Key="SidebarBg" Color="#F7F8FA"/>
          <SolidColorBrush x:Key="CardBg" Color="#EBFFFFFF"/>
          <SolidColorBrush x:Key="CardHoverBg" Color="#F7FFFFFF"/>
          <SolidColorBrush x:Key="CardSunkenBg" Color="#080B1220"/>
          <SolidColorBrush x:Key="GlassSheen" Color="#66FFFFFF"/>
          <SolidColorBrush x:Key="InputBg" Color="#0C0B1220"/>
          <SolidColorBrush x:Key="SegBg" Color="#100B1220"/>
          <SolidColorBrush x:Key="SegSelectedBg" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="Stroke" Color="#170B1220"/>
          <SolidColorBrush x:Key="StrokeSubtle" Color="#0C0B1220"/>
          <SolidColorBrush x:Key="StrokeStrong" Color="#2E0B1220"/>
          <SolidColorBrush x:Key="FocusRing" Color="#5C3482FF"/>
          <SolidColorBrush x:Key="FocusGlow" Color="#293482FF"/>
          <SolidColorBrush x:Key="TextPrimary" Color="#12161F"/>
          <SolidColorBrush x:Key="TextSecondary" Color="#5A6373"/>
          <SolidColorBrush x:Key="TextMuted" Color="#6F7888"/>
