          <SolidColorBrush x:Key="AvatarBg" Color="#1F3482FF"/>
          <SolidColorBrush x:Key="Success" Color="#12A169"/>
          <SolidColorBrush x:Key="SuccessSoft" Color="#1F12A169"/>
          <SolidColorBrush x:Key="Warning" Color="#D98214"/>
          <SolidColorBrush x:Key="WarningSoft" Color="#1FD98214"/>
          <SolidColorBrush x:Key="Danger" Color="#E0454F"/>
