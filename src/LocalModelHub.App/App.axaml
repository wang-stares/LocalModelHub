      <PathGeometry x:Key="IconEdit" FillRule="NonZero" Figures="M15.2,3.9 C16.05,3.05 17.4,3.05 18.25,3.9 L20,5.65 C20.85,6.5 20.85,7.85 20,8.7 L10.9,17.8 L6.9,18.85 C6.2,19.03 5.85,18.6 6.03,17.95 L7.1,13.9 Z M5.4,20 C5.4,19.62 5.71,19.3 6.1,19.3 H17.9 C18.29,19.3 18.6,19.62 18.6,20 C18.6,20.38 18.29,20.7 17.9,20.7 H6.1 C5.71,20.7 5.4,20.38 5.4,20 Z"/>
      <PathGeometry x:Key="IconMore" FillRule="NonZero" Figures="M5.1,12 C5.1,10.88 6.0,9.98 7.12,9.98 C8.24,9.98 9.14,10.88 9.14,12 C9.14,13.12 8.24,14.02 7.12,14.02 C6.0,14.02 5.1,13.12 5.1,12 Z M9.98,12 C9.98,10.88 10.88,9.98 12,9.98 C13.12,9.98 14.02,10.88 14.02,12 C14.02,13.12 13.12,14.02 12,14.02 C10.88,14.02 9.98,13.12 9.98,12 Z M14.86,12 C14.86,10.88 15.76,9.98 16.88,9.98 C18.0,9.98 18.9,10.88 18.9,12 C18.9,13.12 18.0,14.02 16.88,14.02 C15.76,14.02 14.86,13.12 14.86,12 Z"/>
      <StreamGeometry x:Key="IconChevronRight">M9.4,5.6 L15.8,12 L9.4,18.4</StreamGeometry>
      <StreamGeometry x:Key="IconChevronLeft">M14.6,5.6 L8.2,12 L14.6,18.4</StreamGeometry>
      <StreamGeometry x:Key="IconChevronDown">M5.6,9.4 L12,15.8 L18.4,9.4</StreamGeometry>
    </ResourceDictionary>
  </Application.Resources>

  <Application.DataTemplates>
    <DataTemplate DataType="vm:DashboardViewModel">
      <views:DashboardView/>
    </DataTemplate>
    <DataTemplate DataType="vm:ModelsViewModel">
      <views:ModelsView/>
    </DataTemplate>
    <DataTemplate DataType="vm:RecommendViewModel">
      <views:RecommendView/>
    </DataTemplate>
    <DataTemplate DataType="vm:StoreViewModel">
      <views:StoreView/>
    </DataTemplate>
    <DataTemplate DataType="vm:LibraryViewModel">
      <views:LibraryView/>
    </DataTemplate>
    <DataTemplate DataType="vm:ChatViewModel">
      <views:ChatView/>
    </DataTemplate>
    <DataTemplate DataType="vm:KnowledgeMemoryViewModel">
      <views:KnowledgeMemoryView/>
    </DataTemplate>
    <DataTemplate DataType="vm:KnowledgeViewModel">
      <views:KnowledgeView/>
    </DataTemplate>
    <DataTemplate DataType="vm:MemoryViewModel">
      <views:MemoryView/>
    </DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel">
      <views:SettingsView/>
    </DataTemplate>
    <DataTemplate DataType="vm:PhoneViewModel">
      <views:PhoneView/>
    </DataTemplate>
    <DataTemplate DataType="vm:ModelCardViewModel">
      <views:ModelCardView/>
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme/>

    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource AppBg}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, Microsoft YaHei"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <!-- 字号阶梯：档差拉开，避免 11/12/13.5 挤在一起导致"谁都不重要" -->
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="28"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="LineHeight" Value="36"/>
      <Setter Property="LetterSpacing" Value="-0.5"/>
    </Style>
    <Style Selector="TextBlock.display">
      <Setter Property="FontSize" Value="30"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="LineHeight" Value="40"/>
      <Setter Property="LetterSpacing" Value="-0.8"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="19"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="LineHeight" Value="26"/>
      <Setter Property="LetterSpacing" Value="-0.2"/>
    </Style>
    <Style Selector="TextBlock.h3">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
      <Setter Property="FontSize" Value="12.5"/>
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
      <Setter Property="FontSize" Value="11.5"/>
    </Style>
    <Style Selector="TextBlock.releaseHeading">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,10,0,2"/>
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace"/>
    </Style>
    <Style Selector="TextBox.mono">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace"/>
    </Style>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="LetterSpacing" Value="0.9"/>
    </Style>

    <!-- 页面切换动效在 MainWindow 的页面宿主上执行：只做 GPU 变换与透明度，不触发页面重新布局 -->
    <Style Selector="ScrollViewer.page">
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <!-- 窗口底板：系统磨砂（Mica / AcrylicBlur）生效时透出桌面，否则回落到渐变底 -->
    <Style Selector="Grid.shell">
      <Setter Property="Background" Value="{DynamicResource AppBg}"/>
    </Style>
    <Style Selector="Grid.shell.frosted">
      <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- 材质层：半透明亚克力面板（侧边栏状态卡 / 输入区） -->
    <Style Selector="Border.glass">
      <Setter Property="Background" Value="{DynamicResource MicaBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource MicaStroke}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="BoxShadow" Value="0 1 2 0 #0A0B1220, 0 12 32 0 #140B1220"/>
    </Style>

    <Style Selector="Border.codeBlock">
      <Setter Property="Background" Value="{DynamicResource InputBg}"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="Margin" Value="0,2"/>
    </Style>

    <Style Selector="ListBox.sessions">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="ListBox.sessions ListBoxItem">
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Margin" Value="0,0,0,3"/>
    </Style>
    <Style Selector="ListBox.sessions ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SegBg}"/>
    </Style>
    <Style Selector="ListBox.sessions ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
    </Style>

    <!-- 图标：实心轮廓，颜色跟随按钮状态 -->
    <Style Selector="Path.icon">
      <Setter Property="Width" Value="18"/>
      <Setter Property="Height" Value="18"/>
      <Setter Property="Stretch" Value="Uniform"/>
      <Setter Property="Fill" Value="{DynamicResource TextSecondary}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Path.chev">
      <Setter Property="Width" Value="14"/>
      <Setter Property="Height" Value="14"/>
      <Setter Property="Stretch" Value="Uniform"/>
      <Setter Property="Stroke" Value="{DynamicResource TextSecondary}"/>
      <Setter Property="StrokeThickness" Value="1.7"/>
      <Setter Property="StrokeLineCap" Value="Round"/>
      <Setter Property="StrokeJoin" Value="Round"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- 系统图标字体：导航使用 Segoe Fluent Icons 线性字形，与 Win11 原生图标同源 -->
    <Style Selector="TextBlock.navGlyph">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Width" Value="16"/>
      <Setter Property="LineHeight" Value="16"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.nav TextBlock.navGlyph">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>
    <Style Selector="Button.nav:pointerover TextBlock.navGlyph">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style Selector="Button.nav.active TextBlock.navGlyph">
      <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
    </Style>
    <Style Selector="Button.nav Path.icon">
      <Setter Property="Fill" Value="{DynamicResource TextSecondary}"/>
    </Style>
    <Style Selector="Button.nav:pointerover Path.icon">
      <Setter Property="Fill" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style Selector="Button.nav.active Path.icon">
      <Setter Property="Fill" Value="{DynamicResource Accent}"/>
    </Style>
    <Style Selector="Button.nav.active:pointerover Path.icon">
      <Setter Property="Fill" Value="{DynamicResource Accent}"/>
    </Style>
    <Style Selector="Button.icon Path.icon">
      <Setter Property="Fill" Value="{DynamicResource TextSecondary}"/>
    </Style>
    <Style Selector="Button.icon:pointerover Path.icon">
      <Setter Property="Fill" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style Selector="Button.primary Path.icon">
      <Setter Property="Fill" Value="{DynamicResource OnAccent}"/>
    </Style>
    <Style Selector="Button.ghost Path.icon">
      <Setter Property="Fill" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style Selector="TextBlock.score">
      <Setter Property="FontSize" Value="38"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{StaticResource PrimaryGradient}"/>
      <Setter Property="LineHeight" Value="42"/>
    </Style>
    <Style Selector="TextBlock.metric">
      <Setter Property="FontSize" Value="19"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>

    <!-- 材质卡片：半透明表面 + 内外两层柔光阴影，悬停时抬升 -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="18"/>
      <Setter Property="Padding" Value="20"/>
      <Setter Property="BoxShadow" Value="0 1 2 0 #0A0B1220, 0 12 30 0 #0D0B1220"/>
      <Setter Property="Transitions">
        <Transitions>
          <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2" Easing="CubicEaseOut"/>
          <BrushTransition Property="Background" Duration="0:0:0.16"/>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.16"/>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut"/>
        </Transitions>
      </Setter>
    </Style>
    <!-- 次级卡片：无阴影、下沉底色，只做信息承载，不与主卡片争视觉重量 -->
    <Style Selector="Border.card.flat">
      <Setter Property="Background" Value="{DynamicResource SegBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource StrokeSubtle}"/>
      <Setter Property="BoxShadow" Value="none"/>
    </Style>
    <Style Selector="Border.flatHover:pointerover">
      <Setter Property="Background" Value="{DynamicResource CardSunkenBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
    </Style>
    <Style Selector="Border.cardHover:pointerover">
      <Setter Property="Background" Value="{DynamicResource CardHoverBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource StrokeStrong}"/>
      <Setter Property="RenderTransform" Value="translate(0px,-2px)"/>
      <Setter Property="BoxShadow" Value="0 2 6 0 #140B1220, 0 22 48 0 #1C0B1220"/>
    </Style>
    <Style Selector="Border.hero">
      <Setter Property="BoxShadow" Value="0 2 4 0 #140B1220, 0 26 56 0 #241E4FA8"/>
      <Setter Property="CornerRadius" Value="22"/>
    </Style>

    <!-- 品牌标识、状态胶囊、模态卡片：默认沿用澎湃形态，Windows 主题下再压成直角 -->
    <Style Selector="Border.brand">
      <Setter Property="Background" Value="{StaticResource LogoGradient}"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="BoxShadow" Value="0 6 16 0 #333482FF"/>
    </Style>
    <Style Selector="Border.chip">
      <Setter Property="CornerRadius" Value="9"/>
    </Style>
    <Style Selector="Border.dialogCard">
      <Setter Property="CornerRadius" Value="22"/>
      <Setter Property="BoxShadow" Value="0 2 6 0 #140B1220, 0 32 72 0 #330B1220"/>
    </Style>

    <!-- 对话气泡：默认沿用澎湃的渐变与浮起，Windows 主题下压成直角实色 -->
    <Style Selector="Border.bubbleUser">
      <Setter Property="Background" Value="{StaticResource PrimaryGradient}"/>
      <Setter Property="CornerRadius" Value="16,16,6,16"/>
      <Setter Property="BoxShadow" Value="0 4 14 0 #2A1E5BC0"/>
    </Style>
    <Style Selector="Border.bubbleAssistant">
      <Setter Property="CornerRadius" Value="16,16,16,6"/>
      <Setter Property="BoxShadow" Value="0 1 2 0 #0A0B1220, 0 8 20 0 #0B0B1220"/>
    </Style>

    <Style Selector="Border.badge">
      <Setter Property="Background" Value="{DynamicResource BadgeNeutralBg}"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="9,3"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.badge TextBlock">
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="Foreground" Value="{DynamicResource BadgeNeutralFg}"/>
    </Style>
    <Style Selector="Border.badge.pill">
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="Padding" Value="10,3"/>
    </Style>
    <Style Selector="Border.badge.cn">
      <Setter Property="Background" Value="{DynamicResource BadgeCnBg}"/>
    </Style>
    <Style Selector="Border.badge.cn TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource BadgeCnFg}"/>
    </Style>
    <Style Selector="Border.badge.intl">
      <Setter Property="Background" Value="{DynamicResource BadgeIntlBg}"/>
    </Style>
    <Style Selector="Border.badge.intl TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource BadgeIntlFg}"/>
    </Style>
    <Style Selector="Border.badge.local">
      <Setter Property="Background" Value="{DynamicResource BadgeLocalBg}"/>
    </Style>
    <Style Selector="Border.badge.local TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource BadgeLocalFg}"/>
    </Style>
    <Style Selector="Border.badge.capability">
      <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
    </Style>
    <Style Selector="Border.badge.capability TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
    </Style>
    <Style Selector="Border.badge.fitPerfect">
      <Setter Property="Background" Value="{DynamicResource FitPerfectBg}"/>
    </Style>
    <Style Selector="Border.badge.fitPerfect TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource FitPerfectFg}"/>
    </Style>
    <Style Selector="Border.badge.fitGood">
      <Setter Property="Background" Value="{DynamicResource FitGoodBg}"/>
    </Style>
    <Style Selector="Border.badge.fitGood TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource FitGoodFg}"/>
    </Style>
    <Style Selector="Border.badge.fitPlayable">
      <Setter Property="Background" Value="{DynamicResource FitPlayableBg}"/>
    </Style>
    <Style Selector="Border.badge.fitPlayable TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource FitPlayableFg}"/>
    </Style>
    <Style Selector="Border.badge.fitTight">
      <Setter Property="Background" Value="{DynamicResource FitTightBg}"/>
    </Style>
    <Style Selector="Border.badge.fitTight TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource FitTightFg}"/>
    </Style>
    <Style Selector="Border.badge.fitBad">
      <Setter Property="Background" Value="{DynamicResource FitBadBg}"/>
    </Style>
    <Style Selector="Border.badge.fitBad TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource FitBadFg}"/>
    </Style>
    <Style Selector="Border.badge.accent">
      <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
    </Style>
    <Style Selector="Border.badge.accent TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
    </Style>

    <!-- 适配状态点：表格里用色点表达结论，把横向空间让给模型名与参数 -->
    <Style Selector="Border.fitDot">
      <Setter Property="Width" Value="7"/>
      <Setter Property="Height" Value="7"/>
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="Background" Value="{DynamicResource TextMuted}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.fitDot.fitPerfect">
      <Setter Property="Background" Value="{DynamicResource FitPerfectFg}"/>
    </Style>
    <Style Selector="Border.fitDot.fitGood">
      <Setter Property="Background" Value="{DynamicResource FitGoodFg}"/>
    </Style>
    <Style Selector="Border.fitDot.fitPlayable">
      <Setter Property="Background" Value="{DynamicResource FitPlayableFg}"/>
    </Style>
    <Style Selector="Border.fitDot.fitTight">
      <Setter Property="Background" Value="{DynamicResource FitTightFg}"/>
    </Style>
    <Style Selector="Border.fitDot.fitBad">
      <Setter Property="Background" Value="{DynamicResource FitBadFg}"/>
    </Style>

    <Style Selector="Border.tile">
      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <!-- 空状态图标底座：Miuix 用柔色圆角块，Windows 主题下退化为纯图标 -->
    <Style Selector="Border.emptyIcon">
      <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
      <Setter Property="CornerRadius" Value="14"/>
    </Style>
    <Style Selector="Border.tile TextBlock">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace"/>
    </Style>
    <Style Selector="Border.tile.cpu">
      <Setter Property="Background" Value="{DynamicResource TileCpuBg}"/>
    </Style>
    <Style Selector="Border.tile.cpu TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TileCpuFg}"/>
    </Style>
    <Style Selector="Border.tile.gpu">
      <Setter Property="Background" Value="{DynamicResource TileGpuBg}"/>
    </Style>
    <Style Selector="Border.tile.gpu TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TileGpuFg}"/>
    </Style>
    <Style Selector="Border.tile.ram">
      <Setter Property="Background" Value="{DynamicResource TileRamBg}"/>
    </Style>
    <Style Selector="Border.tile.ram TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TileRamFg}"/>
    </Style>
    <Style Selector="Border.tile.disk">
      <Setter Property="Background" Value="{DynamicResource TileDiskBg}"/>
    </Style>
    <Style Selector="Border.tile.disk TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TileDiskFg}"/>
    </Style>

    <Style Selector="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut"/>
        </Transitions>
      </Setter>
    </Style>
    <!-- 按压回弹：澎湃式轻量触感，不改变布局尺寸 -->
    <Style Selector="Button:pressed">
      <Setter Property="RenderTransform" Value="scale(0.98)"/>
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="20,9"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource PrimaryGradient}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.14"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.primary TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentPressed}"/>
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Opacity" Value="0.45"/>
    </Style>

    <Style Selector="Button.ghost">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Padding" Value="15,8"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="Button.ghost /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.14"/>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.14"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.ghost TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource InputBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource StrokeStrong}"/>
    </Style>
    <Style Selector="Button.ghost:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Opacity" Value="0.4"/>
    </Style>

    <Style Selector="Button.soft">
      <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="15,8"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="Button.soft /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="Button.soft TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
    </Style>
    <Style Selector="Button.soft:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoftHover}"/>
    </Style>
    <Style Selector="Button.soft:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Opacity" Value="0.4"/>
    </Style>

    <Style Selector="Button.danger">
      <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Padding" Value="15,8"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="Button.danger /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource DangerSoft}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="Button.danger TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource DangerHover}"/>
    </Style>
    <Style Selector="Button.danger:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Opacity" Value="0.4"/>
    </Style>

    <Style Selector="Button.icon">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.icon /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.14"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.icon TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource InputBg}"/>
    </Style>
    <Style Selector="Button.icon:pointerover TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>

    <!-- 一级入口：常态透明，选中时左侧 3px 强调条 + 胶囊底色（Fluent 指示条 × 澎湃圆角） -->
    <Style Selector="Button.nav">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="Button.nav /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="3,0,0,0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.14"/>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.18"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.nav TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource InputBg}"/>
    </Style>
    <Style Selector="Button.nav:pointerover TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style Selector="Button.nav.active /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    </Style>
    <Style Selector="Button.nav.active TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.nav.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoftHover}"/>
    </Style>
    <Style Selector="Button.nav.active:pointerover TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
    </Style>

    <!-- 分组标题：承担折叠/展开与分组定位，不使用整块高亮避免与子项重复 -->
    <Style Selector="Button.navGroup">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="Button.navGroup /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="3,0,0,0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.14"/>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.18"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.navGroup TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.navGroup Path.icon">
      <Setter Property="Stroke" Value="{DynamicResource TextSecondary}"/>
    </Style>
    <Style Selector="Button.navGroup:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource InputBg}"/>
    </Style>
    <Style Selector="Button.navGroup:pointerover TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style Selector="Button.navGroup:pointerover Path.icon">
      <Setter Property="Stroke" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style Selector="Button.navGroup.active /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    </Style>
    <Style Selector="Button.navGroup.active TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
    </Style>
    <Style Selector="Button.navGroup.active Path.icon">
      <Setter Property="Stroke" Value="{DynamicResource Accent}"/>
    </Style>

    <!-- 二级菜单项：更紧凑的缩进条目 -->
    <Style Selector="Button.navSub">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button.navSub /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="2,0,0,0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.14"/>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.18"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.navSub TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="Button.navSub Path.icon">
      <Setter Property="Stroke" Value="{DynamicResource TextMuted}"/>
      <Setter Property="StrokeThickness" Value="1.15"/>
    </Style>
    <Style Selector="Button.navSub:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource InputBg}"/>
    </Style>
    <Style Selector="Button.navSub:pointerover TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style Selector="Button.navSub:pointerover Path.icon">
      <Setter Property="Stroke" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style Selector="Button.navSub.active /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    </Style>
    <Style Selector="Button.navSub.active TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.navSub.active Path.icon">
      <Setter Property="Stroke" Value="{DynamicResource Accent}"/>
    </Style>
    <Style Selector="Button.navSub.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoftHover}"/>
    </Style>

    <Style Selector="ListBox.segments">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="2"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.segmentHost">
      <Setter Property="Background" Value="{DynamicResource SegBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource StrokeSubtle}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="3"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="BoxShadow" Value="0 1 2 0 #080B1220"/>
    </Style>
    <Style Selector="Border.composer">
      <Setter Property="Background" Value="{DynamicResource CardBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="18"/>
      <Setter Property="Padding" Value="8,8,8,8"/>
      <Setter Property="BoxShadow" Value="0 1 2 0 #0A0B1220, 0 14 32 0 #0E0B1220"/>
    </Style>
    <Style Selector="TextBox.chatInput">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="MinHeight" Value="40"/>
    </Style>
    <Style Selector="TextBox.chatInput /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="ListBox.segments ListBoxItem">
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Margin" Value="1,0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="ListBox.segments ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.14"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ListBox.segments ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SegSelectedBg}"/>
    </Style>
    <Style Selector="ListBox.segments ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SegSelectedBg}"/>
    </Style>
    <Style Selector="ListBox.segments ListBoxItem:selected">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="ListBox.segments ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SegSelectedBg}"/>
    </Style>

    <Style Selector="TextBox">
      <Setter Property="Background" Value="{DynamicResource InputBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="13,8"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource StrokeStrong}"/>
      <Setter Property="Background" Value="{DynamicResource InputBg}"/>
    </Style>
    <!-- 聚焦：Fluent 2px 焦点环 + 澎湃柔光外扩 -->
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="Background" Value="{DynamicResource InputBg}"/>
      <Setter Property="BoxShadow" Value="0 0 0 3 #293482FF"/>
    </Style>
    <Style Selector="TextBox.search">
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="15,8"/>
    </Style>

    <Style Selector="ProgressBar">
      <Setter Property="Height" Value="6"/>
      <Setter Property="Background" Value="{DynamicResource ProgressBg}"/>
      <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="CornerRadius" Value="3"/>
    </Style>

    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="MinHeight" Value="30"/>
    </Style>

    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
      <Setter Property="Background" Value="{DynamicResource InputBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="NumericUpDown">
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
      <Setter Property="Background" Value="{DynamicResource InputBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- 工具提示：与卡片同一材质语言，避免系统默认深色气泡破坏材质一致性 -->
    <Style Selector="ToolTip">
      <Setter Property="Background" Value="{DynamicResource CardBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>

    <Style Selector="Separator.hairline">
      <Setter Property="Background" Value="{DynamicResource Stroke}"/>
      <Setter Property="Height" Value="1"/>
    </Style>

    <!-- ==================== Windows 11 主题 ====================
         由窗口类 windows 启用：实色表面 + 1px 描边卡片（8px 圆角）、控件 4px 直角、
         中性灰选中态 + 3px 强调条、Segoe UI 字号阶梯、纯色强调按钮。
         只改形态与材质，不改页面结构；Miuix 的圆角、渐变与浮起阴影一律不参与。 -->
    <Style Selector="Window.windows">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"/>
    </Style>

    <!-- 字号阶梯对齐 WinUI：Title 28 / Subtitle 20 / Body 14 / Caption 12，字距归零 -->
    <Style Selector="Window.windows TextBlock.h1">
      <Setter Property="FontSize" Value="28"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="LineHeight" Value="36"/>
      <Setter Property="LetterSpacing" Value="0"/>
    </Style>
    <Style Selector="Window.windows TextBlock.display">
      <Setter Property="FontSize" Value="28"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="LineHeight" Value="36"/>
      <Setter Property="LetterSpacing" Value="0"/>
    </Style>
    <Style Selector="Window.windows TextBlock.h2">
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="LineHeight" Value="28"/>
      <Setter Property="LetterSpacing" Value="0"/>
    </Style>
    <Style Selector="Window.windows TextBlock.h3">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Window.windows TextBlock.muted">
      <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style Selector="Window.windows TextBlock.caption">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="LineHeight" Value="17"/>
    </Style>
    <Style Selector="Window.windows TextBlock.eyebrow">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="LetterSpacing" Value="0"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>
    <Style Selector="Window.windows TextBlock.metric">
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Window.windows TextBlock.score">
      <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
    </Style>

    <!-- 表面：实色卡片 + 1px 描边，圆角取 WinUI ControlCornerRadius = 4，取消阴影与抬升 -->
    <Style Selector="Window.windows Border.card">
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="20"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
      <Setter Property="BoxShadow" Value="none"/>
    </Style>
    <Style Selector="Window.windows Border.card.flat">
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Background" Value="{DynamicResource CardBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
      <Setter Property="BoxShadow" Value="none"/>
    </Style>
    <Style Selector="Window.windows Border.cardHover:pointerover">
      <Setter Property="Background" Value="{DynamicResource CardHoverBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource StrokeStrong}"/>
      <Setter Property="RenderTransform" Value="translate(0px,0px)"/>
      <Setter Property="BoxShadow" Value="none"/>
    </Style>
    <Style Selector="Window.windows Border.hero">
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="BoxShadow" Value="none"/>
    </Style>
    <Style Selector="Window.windows Border.glass">
      <Setter Property="Background" Value="{DynamicResource CardBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="BoxShadow" Value="none"/>
    </Style>
    <Style Selector="Window.windows Border.composer">
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
      <Setter Property="BoxShadow" Value="none"/>
    </Style>
    <Style Selector="Window.windows Border.bubbleUser">
      <Setter Property="Background" Value="{DynamicResource Accent}"/>
      <Setter Property="CornerRadius" Value="4,4,0,4"/>
      <Setter Property="BoxShadow" Value="none"/>
    </Style>
    <Style Selector="Window.windows Border.bubbleAssistant">
      <Setter Property="CornerRadius" Value="4,4,4,0"/>
      <Setter Property="BoxShadow" Value="none"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
    </Style>
    <Style Selector="Window.windows Border.bubbleUser Button.ghost /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Window.windows Border.bubbleAssistant Button.ghost /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Window.windows Border.brand">
      <Setter Property="Background" Value="{DynamicResource Accent}"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="BoxShadow" Value="none"/>
    </Style>
    <Style Selector="Window.windows Border.chip">
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="BoxShadow" Value="none"/>
    </Style>
    <Style Selector="Window.windows Border.dialogCard">
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="BoxShadow" Value="none"/>
    </Style>
    <Style Selector="Window.windows Border.segmentHost">
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="2"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
      <Setter Property="BoxShadow" Value="none"/>
    </Style>
    <Style Selector="Window.windows Border.badge">
      <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="Window.windows Border.badge.pill">
      <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <!-- 指标色块是 Miuix 的装饰元素，Win11 页面用纯文字标签 + 单色图标 -->
    <Style Selector="Window.windows Border.tile">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="Window.windows Border.emptyIcon">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="0"/>
    </Style>

    <!-- 导航：36 高、4px 直角；选中是中性灰底 + 3px 强调条，文字保持主色而不是变蓝 -->
    <Style Selector="Window.windows Button.nav">
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="11,0"/>
      <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="Window.windows Button.nav /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="Window.windows Button.nav Path.icon">
      <Setter Property="Width" Value="16"/>
      <Setter Property="Height" Value="16"/>
    </Style>
    <Style Selector="Window.windows Button.nav TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style Selector="Window.windows Button.nav TextBlock.navGlyph">
      <Setter Property="FontSize" Value="16"/>
    </Style>
    <Style Selector="Window.windows Button.nav.active TextBlock.navGlyph">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style Selector="Window.windows Button.nav.active:pointerover TextBlock.navGlyph">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <!-- Win11 设置页没有分组标题与分隔线，导航直接排布 -->
    <Style Selector="Window.windows Border.navDivider">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="Window.windows Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource InputBg}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Window.windows Button.nav.active /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NavActiveBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    </Style>
    <Style Selector="Window.windows Button.nav.active TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
      <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style Selector="Window.windows Button.nav.active Path.icon">
      <Setter Property="Fill" Value="{DynamicResource TextPrimary}"/>
    </Style>
