          <SolidColorBrush x:Key="AccentHover" Color="#4B90FF"/>
          <SolidColorBrush x:Key="AccentPressed" Color="#2563D8"/>
          <SolidColorBrush x:Key="AccentSoft" Color="#1C3482FF"/>
          <SolidColorBrush x:Key="AccentSoftHover" Color="#2B3482FF"/>
          <SolidColorBrush x:Key="AccentInk" Color="#1657C8"/>
